# LiteLLM OpenAI-compatible gateway configuration
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=sk-your-litellm-virtual-key

# Persistent data directory (SQLite database & logs)
COUNCIL_DATA_DIR=./data

# Optional: comma-separated model substrings to hide from picker
COUNCIL_EXCLUDED_MODEL_PATTERNS=embedding,tts,transcribe,whisper,ocr,moderation,rerank
